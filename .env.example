# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Required if you want to use Supabase as your primary backend.
# If these are not provided, the app will automatically fall back to a high-performance local database.
# IMPORTANT: never commit real service-role credentials. Leave these empty in this file
# and configure real values via the Secrets environment of your hosting platform.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# STRIPE: Required for payment processing.
# If not provided, checkout will gracefully run in an elegant, interactive demo modal simulation.
STRIPE_SECRET_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# ADMIN & CUSTOMER CHANNEL INTEGRATIONS
# Server-side only. Never prefix these with VITE_ (that would expose them to the client bundle).
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
VITE_WHATSAPP_NUMBER=""